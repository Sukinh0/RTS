{
  "name": "rts-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "simulate": "node scripts/simulate.mjs",
    "benchmark": "node scripts/performance.mjs",
    "benchmark:browser": "node scripts/performance-browser.mjs",
    "assets:install": "powershell -ExecutionPolicy Bypass -File scripts/install-tiny-swords.ps1",
    "prebuild": "node scripts/prepare-tiny-swords.mjs",
    "predev": "node scripts/prepare-tiny-swords.mjs",
    "predev:sandbox": "node scripts/prepare-tiny-swords.mjs",
    "assets:prepare": "node scripts/prepare-tiny-swords.mjs",
    "test:assets": "node --test scripts/prepare-tiny-swords.test.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
